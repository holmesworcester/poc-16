{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poc16-upload-boundary-placeholder",
  "main": "build/broker/entry.py",
  "base_dir": "build/broker",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "r2_buckets": [],
  "vars": {
    "POC16_DEPLOYMENT_OWNER": "replace-with-deployment-owner",
    "POC16_DEPLOYMENT_ROLE": "broker"
  },
  "python_modules": {
    "excludes": [
      "**/*.pyc",
      "**/__pycache__"
    ]
  }
}
